<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme; Compose drives the actual colors. Material3 NoActionBar so the
         Compose scaffold owns the whole surface (edge-to-edge). -->
    <style name="Theme.Phoenix" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
